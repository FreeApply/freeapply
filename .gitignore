# FreeApply public repository (published from FreeApply/prod).
# Allow-list: everything is private unless it is named below, so a new file stays out until someone decides it is
# public. Public means what users already receive: the app package, the Claude Code plugin files, this README, the
# license and the release notes. The server, website, deploy kit, release tools, workflow source, ad deals, internal docs and the
# handoff stay private.
/*
!/.gitignore
!/README.md
!/LICENSE
!/release-notes/
!/.claude-plugin/
!/.mcp.json
!/skills/
!/agent/

# Notes for the next release stay private until it ships.
/release-notes/UNRELEASED.md

# Inside agent/, exactly what the app package ships.
/agent/*
!/agent/manifest.json
!/agent/package.json
!/agent/workflow.signed.json
!/agent/src/
!/agent/web/
!/agent/keys/
/agent/keys/*
!/agent/keys/release.pub
!/agent/keys/ads.pub

# Never, wherever they appear.
.env
.env.*
*.pem
*.key
*.key.json
node_modules/
*.log
.DS_Store
Thumbs.db
